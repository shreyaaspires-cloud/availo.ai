APP_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:3000

# Auth
JWT_SECRET=availo-super-secret-jwt-key-minimum-32-chars-long-2026
JWT_ACCESS_EXPIRES_MINUTES=60
JWT_REFRESH_EXPIRES_DAYS=30

# Database (Supabase / Postgres asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/availo_db
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/availo_db

# Supabase Storage
SUPABASE_URL=https://dummy.supabase.co
SUPABASE_SERVICE_KEY=dummy-service-key-for-local-dev
SUPABASE_STORAGE_BUCKET_CONDITIONS=condition-photos
SUPABASE_STORAGE_BUCKET_DOCS=verification-docs
SUPABASE_STORAGE_BUCKET_CONTRACTS=contracts

# Cache (Upstash Redis)
UPSTASH_REDIS_URL=https://dummy.upstash.io
UPSTASH_REDIS_TOKEN=dummy-token

# AI (Google Gemini)
GEMINI_API_KEY=dummy-gemini-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_CACHE_TTL=86400

# Email (Resend)
RESEND_API_KEY=re_dummy_key
RESEND_FROM_EMAIL=notifications@availo.app

# Fair-use policy
MAX_ACTIVE_BOOKINGS_PER_USER=3
MAX_BOOKINGS_PER_RESOURCE_PER_WEEK=2
WAITLIST_AUTO_PROMOTE_MINUTES=30

# Demo credentials (seeded)
DEMO_USER_PASSWORD=DemoUser@Availo
DEMO_OWNER_PASSWORD=DemoOwner@Availo
DEMO_ADMIN_PASSWORD=DemoAdmin@Availo
